<Window x:Class="Wpfdesign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpfdesign"
        mc:Ignorable="d"
      Height="570"
        Width="360"
        WindowStartupLocation="CenterScreen">

    <!-- Background Image -->
    <Window.Background>
        <ImageBrush ImageSource="/Image/bgimage.png"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <!-- Main Container -->
    <Border CornerRadius="30"
            Background="#EBECEF"
            Padding="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel Width="300">

            <!-- Title -->
            <TextBlock Text="Register"
                       FontSize="20"
                       FontWeight="SemiBold"
                       FontFamily="Arial"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- FIRST NAME -->
            <StackPanel Margin="0,0,0,10">
                <Label Content="First Name" Margin="0,0,0,5"/>

                <Border CornerRadius="20"
                        Background="Black"
                        Height="35">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Icon -->
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="12,0,10,0"
                                   VerticalAlignment="Center"/>

                        <!-- Input -->
                        <TextBox BorderThickness="0"
                                 Background="Black"
                                 Foreground="White"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Width="200"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- LAST NAME -->
            <StackPanel Margin="0,0,0,10">
                <Label Content="Last Name" Margin="0,0,0,5"/>

                <Border CornerRadius="20"
                        Background="Black"
                        Height="35">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Icon -->
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="12,0,10,0"
                                   VerticalAlignment="Center"/>

                        <!-- Input -->
                        <TextBox BorderThickness="0"
                                 Background="Black"
                                 Foreground="White"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Width="200"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PASSWORD -->
            <StackPanel Margin="0,0,0,10">
                <Label Content="Password" Margin="0,0,0,5"/>

                <Border CornerRadius="20"
                        Background="Black"
                        Height="35">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Icon -->
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="12,0,10,0"
                                   VerticalAlignment="Center"/>

                        <!-- Input -->
                        <PasswordBox BorderThickness="0"
                                     Background="Black"
                                     Foreground="White"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     Width="200"/>
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,0,10">
                    <Label Content="Password" Margin="0,0,0,5"/>

                    <Border CornerRadius="20"
            Background="Black"
            Height="35">

                        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

                            <!-- Icon -->
                            <TextBlock Text="&#xE72E;"
                       FontFamily="Segoe MDL2 Assets"
                       Foreground="White"
                       FontSize="18"
                       Margin="12,0,10,0"
                       VerticalAlignment="Center"/>

                            <!-- Input -->
                            <PasswordBox BorderThickness="0"
                         Background="Black"
                         Foreground="White"
                         FontSize="14"
                         VerticalAlignment="Center"
                         Width="200"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>

            <Border CornerRadius="20"
                    Width="200"
                    Height="35"
                    Background="BlueViolet"
                    BorderBrush="Pink"
                    BorderThickness="2">
                <Button Content="save"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="Bold"
                        Cursor="Hand">
                    
                </Button>
                
            </Border>
          

        </StackPanel>
    </Border>



</Window>
